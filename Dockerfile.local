# Local docker-compose build: builds email-service from source. Not used by
# the ghcr/production pipeline (see Makefile's `docker`/`docker-prod` targets
# for that) — see local-stack/ in the sibling directory for the compose file
# that references this.
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/email-service ./cmd/main.go

FROM alpine:3.15.4
WORKDIR /app
COPY --from=build /out/email-service /app/email-service
VOLUME ["/templates"]
CMD ["/app/email-service"]
